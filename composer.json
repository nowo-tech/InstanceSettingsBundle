{
    "name": "nowo-tech/instance-settings-bundle",
    "description": "Runtime instance settings for Symfony apps: one settings store split into tagged sections, encrypted secret fields, admin forms and import / export (portability).",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "bundle",
        "settings",
        "configuration",
        "admin",
        "runtime",
        "encryption",
        "nowo",
        "frankenphp"
    ],
    "homepage": "https://github.com/nowo-tech/InstanceSettingsBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Maintainer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "support": {
        "issues": "https://github.com/nowo-tech/InstanceSettingsBundle/issues",
        "source": "https://github.com/nowo-tech/InstanceSettingsBundle",
        "docs": "https://github.com/nowo-tech/InstanceSettingsBundle/tree/main/docs",
        "changelog": "https://github.com/nowo-tech/InstanceSettingsBundle/blob/main/docs/CHANGELOG.md"
    },
    "require": {
        "php": ">=8.2 <8.6",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\InstanceSettingsBundle\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
