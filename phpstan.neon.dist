# PHPStan configuration for Instance Settings Bundle.
#
# Run: make phpstan
parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        - vendor/*
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []
    # 1.19 (Beacon spec 239): the load-readiness flags of phpstan-frankenphp 1.4.
    frankenphp:
        flagRollbackAfterNestedBegin: true
        flagFlushInHandWrittenTransaction: true
        flagUnboundedRecursion: true
        flagFlushWithoutClosedManagerRecovery: true

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  # worker-strict includes default worker rules + request-superglobal hygiene (kernel not reset).
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-hardening.neon
