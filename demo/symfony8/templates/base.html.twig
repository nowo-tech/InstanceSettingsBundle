{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). It is also the host layout of the bundle pages (nowo_ui_kit.layouts.admin).
    The header menu lists the demo pages with the active item. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Instance Settings Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Instance Settings Bundle Demo</a>
        <nav class="nowo-ui-header__nav" aria-label="Demo">
            <a class="nowo-ui-link" href="{{ path('demo_home') }}"{% if _route == 'demo_home' %} aria-current="page"{% endif %}>Home</a>
            <a class="nowo-ui-link" href="{{ path('nowo_instance_settings_index') }}"{% if _route starts with 'nowo_instance_settings' %} aria-current="page"{% endif %}>Settings</a>
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# UiKit visible-when peer (provider-dependent fields, InstanceSettings 1.3): demo Stimulus app. #}
    <script src="{{ asset('js/nowo-ui-demo-peers.js') }}" defer></script>
{% endblock %}
