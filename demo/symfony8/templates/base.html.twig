{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform); the bundle pages render through it too (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Instance Settings',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/InstanceSettingsBundle',
    translation_domain: false,
    locales: [],
    nav: [
        {label: 'Home', route: 'demo_home'},
        {label: 'Settings', route: 'nowo_instance_settings_index', active: ['nowo_instance_settings_*']},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Instance Settings Demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# UiKit visible-when peer (provider-dependent fields, InstanceSettings 1.3): demo Stimulus app. #}
    <script src="{{ asset('js/nowo-ui-demo-peers.js') }}" defer></script>
{% endblock %}
