{% extends 'base.html.twig' %}

{% block title %}Home - Instance Settings Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: instance_setting('site.name'),
        intro: 'Instance-wide settings split into sections contributed by the host or by other bundles (site, mailer, SMS here). Values live in MySQL; secrets are encrypted at rest with nowo-tech/doctrine-encrypt-bundle and never rendered back.',
    }) }}
{% endblock %}

{% block body %}
    <p class="nowo-ui-muted">
        FrankenPHP mode: <strong>worker</strong> by default (<code>FRANKENPHP_MODE</code>). A saved change applies on the
        next request without restarting the worker.
    </p>

    <section class="nowo-ui-card" data-testid="demo-values">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Read by the application</h2></div>
        <div class="nowo-ui-card__body">
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Footer</dt><dd class="nowo-ui-detail-list__value">{{ site.footer ?? '—' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Rows per page</dt><dd class="nowo-ui-detail-list__value" data-testid="demo-page-size">{{ site.page_size }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Theme</dt><dd class="nowo-ui-detail-list__value">{{ site.theme }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Mailer sender</dt><dd class="nowo-ui-detail-list__value">{{ mailer_from }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Mailer DSN</dt><dd class="nowo-ui-detail-list__value">{{ dsn_stored ? 'stored (encrypted)' : 'not set' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">SMS provider</dt><dd class="nowo-ui-detail-list__value">{{ sms_provider }} — token {{ token_stored ? 'stored' : 'not set' }}</dd></div>
            </dl>
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Manage</h2></div>
        <div class="nowo-ui-card__body">
            <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_instance_settings_index') }}">Open the settings</a>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('nowo_instance_settings_portability') }}">Import / export</a>
        </div>
    </section>
{% endblock %}
