{#
  1.17 (web_ui.reveal_in_input): the reveal script alone, for a page whose form has LOCKED secret rows
  (data-nowo-instance-settings-locked, a stored revealable secret) but no Reveal control — an editor who may not
  reveal. The script makes those inputs read-only, hides PasswordToggle's eye while locked and unlocks a row when its
  "Replace the stored value" box is ticked; the server ignores a value posted for a locked row without that box anyway.
  Variable: secret_lock (true), set by the section page. Optional: nonce (default the request attribute csp_nonce).
  No secret, no endpoint URL and no token are printed here. No inline handler (strict CSP safe).
#}
{%- set _request = app is defined and app ? app.request : null -%}
{%- set _nonce = nonce|default(_request ? _request.attributes.get('csp_nonce') : null) -%}
<script src="{{ asset('bundles/nowoinstancesettings/js/nowo-instance-settings-reveal.js') }}" defer{% if _nonce %} nonce="{{ _nonce }}"{% endif %} data-nowo-instance-settings-reveal-script></script>
