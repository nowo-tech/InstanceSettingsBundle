{#
  Colour input assets (1.12): the bundle stylesheet and the colour script (deferred), from the bundle's public assets
  (bundles/nowoinstancesettings/, assets:install), both with the request `csp_nonce` attribute when there is one.
  Included by settings/section.html.twig when the form has a colour field (color_picker); host section templates
  include it the same way: {{ include('@NowoInstanceSettingsBundle/settings/_color_assets.html.twig') }}.
  Optional: nonce (default the request attribute csp_nonce).
#}
{%- set _request = app is defined and app ? app.request : null -%}
{%- set _nonce = nonce|default(_request ? _request.attributes.get('csp_nonce') : null) -%}
{{- include('@NowoInstanceSettingsBundle/settings/_styles.html.twig', {nonce: _nonce}) -}}
<script src="{{ asset('bundles/nowoinstancesettings/js/nowo-instance-settings-color.js') }}" defer{% if _nonce %} nonce="{{ _nonce }}"{% endif %} data-nowo-instance-settings-color-script></script>
