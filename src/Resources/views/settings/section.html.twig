{#
  Instance settings section page (REQ-UI-003): UiKit settings scaffold.
  Variable: page (View\SettingsPage from SettingsPageFactory::section(): header (title, intro, "Import / export" action),
  one tab per section the user may open, the current section form (SettingsSectionType; the scaffold renders the
  REQ-TWIG-003 child loop and the submit button) and the section's extra actions). Also: section (current name).
  Without any section, SettingsPageFactory::empty() (header only).
  Optional (1.2): notices (list of UiKit Labels from SettingsPageFactory::notices(), the section's
  SettingsSectionNoticesInterface warnings), rendered as UiKit `flash_warning` alerts above the current section form.
  Optional (1.5): image_previews (list of Ui\ImagePreview: the stored image of each image field with the `preview` form
  option, by its file route URL only; never bytes, data: or base64), rendered above the form.
  Optional (1.8): image_crop (true when an image field has the crop step): loads UiKit's image-crop script (nonce from
  the csp_nonce request attribute; the runtime binds once even when the host layout loads it too).
  Optional (1.12): color_picker (true when a colour field is on the form): loads the bundle's colour script and
  stylesheet (bundles/nowoinstancesettings/, assets:install; script deferred with the csp_nonce request attribute).
  Data block: nowo_ui_settings_section (`section` in context).
#}
{% extends '@NowoUiKit/page/settings.html.twig' %}

{% block nowo_ui_settings_section %}
    {% if section.form %}
        {% for notice in notices|default([]) %}
            <div class="{{ nowo_ui_class('flash_warning', page.bundle) }}" role="alert" data-testid="instance-settings-notice">{{ notice|nowo_ui_trans }}</div>
        {% endfor %}
        {%- if image_previews|default([]) is not empty %}
        <ul class="nowo-instance-settings-previews" data-testid="instance-settings-image-previews">
            {% for preview in image_previews %}
            <li data-field="{{ preview.field }}">
                <figure>
                    <img src="{{ preview.url }}" alt="{{ preview.label|nowo_ui_trans }}" width="{{ preview.width }}" height="{{ preview.height }}" loading="lazy" decoding="async">
                    <figcaption class="{{ nowo_ui_class('muted', page.bundle) }}">{{ preview.label|nowo_ui_trans }}</figcaption>
                </figure>
            </li>
            {% endfor %}
        </ul>
        {%- endif %}
    {% endif %}
    {% if image_crop|default(false) %}{{ include(nowo_ui_partial('scripts', page.bundle), {script_names: ['image-crop']}) }}{% endif %}{% if color_picker|default(false) %}{{ include('@NowoInstanceSettingsBundle/settings/_color_assets.html.twig') }}{% endif %}{{ parent() }}
{% endblock %}
